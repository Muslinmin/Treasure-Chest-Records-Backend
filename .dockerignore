# Security: Never bake secrets or live data into the image
data/
.env

# Python Cache: Avoid copying host machine bytecode
__pycache__/
*.pyc

# Host virtualenv: 300MB+ of host-specific wheels the image rebuilds itself
.venv/

# Version Control: Unnecessary for runtime
.git/
.gitignore

# Testing: Keeps the production image footprint small
tests/